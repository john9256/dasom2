<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasom2.mapper.testMapper">

    <select id="selectTest" resultType="String">
        SELECT * FROM testtable
    </select>
    
    <select id="checkUserId" resultType="String">
        SELECT COUNT(*) FROM user_table WHERE user_id = #{userId}
    </select>
    
    <select id="getResidenceData" resultType="String">
        SELECT value1 FROM criteria_data WHERE user_id = #{userId}
    </select>
</mapper>