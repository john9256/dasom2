    </select>
    
    <select id = "checkChace">
    	SELECT CHANCE FROM USER_MANAGE WHERE USER_ID = #{userId}
    </select>
    
    <update id = "minusChance">
    	UPDATE USER_MANAGE SET CHANCE = CHANCE -1 WHERE USER_ID = #{userId}
    </update>
    
    <update id = "plusChance">
    	UPDATE USER_MANAGE SET CHANCE = CHANCE +1 WHERE USER_ID = #{userId}
    </update>
    
    <select id="checkMatchPickCount">
        SELECT COUNT(*) 
        FROM MATCHING
		WHERE USER_ID = #{userId}
		AND EPISODE = #{episode}
    </select>
    
    <select id ="getParticipantList">
    	SELECT A.SEX AS sex, B.JOB_DIVISION AS jobDivision, A.EPISODE AS episode, YEAR(CURDATE()) - YEAR(B.BIRTHDAY) AS year 
    	FROM participant_user A
