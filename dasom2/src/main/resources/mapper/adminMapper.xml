    <delete id="deleteParticipantUser" >
        DELETE FROM PARTICIPANT_USER WHERE USER_ID = #{userId} AND EPISODE = #{episode}
    </delete>
    
    <select id="getPassFlagbyUser" resultType="String" parameterType="String">
    	SELECT pass_flag FROM user_manage WHERE user_id = #{userId} AND PASS_FLAG = 'Y'
    </select>
    
    <select id="getMatchingInfo" resultType="matchPersonVO" parameterType="String">
    	SELECT  A.USER_ID AS PICKED_USER_ID, NICKNAME, B.PICK, B.PICK_TYPE, A.EPISODE AS localDateTimeEpisode
		FROM PARTICIPANT_USER A
        
        LEFT OUTER JOIN 
        
        (SELECT * FROM MATCHING A WHERE A.USER_ID = #{userId}) B
        ON A.NICKNAME = B.PICK
        AND A.EPISODE = B.EPISODE

